{% import "macros.html.j2" as m %}

<section id="projects" class="lazy-paint relative overflow-hidden" tabindex="-1" aria-labelledby="projects-title"
         style="background-color:var(--cyan); background-image:radial-gradient(rgba(0,0,0,.18) 1.8px, transparent 1.9px); background-size:20px 20px">
  <div class="relative mx-auto max-w-site px-4 sm:px-6 py-14 sm:py-20">
    {{ m.sec_head('projects', 'Projects', m.sticker('all deployed', 'pink', 'anim-wobble')) }}

    {# One project goes full width rather than sitting in a half-empty row;
       two or more split into columns. The grid follows the content. #}
    <div class="mt-8 grid gap-7{% if projects|length > 1 %} md:grid-cols-2{% endif %}">
      {%- for p in projects %}
      {%- set dark = p.accent in m.DARK %}
      {%- set head = m.HEAD_INK.get(p.accent) %}
      {%- set muted = m.MUTED_INK.get(p.accent) %}
      <article class="{{ m.plate(p.accent) }} card rv kinetic flex flex-col">
        {{ m.sticker(p.tag, p.tag_accent, 'self-start') }}
        <h3 class="display mt-4" style="font-size:2.5rem{% if head %}; color:{{ head }}{% endif %}">{{ p.name }}</h3>
        <p class="mt-3 text-[15px] leading-relaxed flex-1">{{ p.blurb }}</p>
        <p class="mt-4 text-xs font-bold tracking-widest uppercase"{% if muted %} style="color:{{ muted }}"{% endif %}>{{ p.tech }}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          {%- for link in p.links %}
          {{ m.btn(link.label ~ ' ↗', link.href, link.accent, small=true, aria=link.aria) }}
          {%- endfor %}
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{{ m.marquee(marquees.projects, 'marquee--cyan marquee--fast') }}

<hr class="rule" />
