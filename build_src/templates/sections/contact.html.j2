{% import "macros.html.j2" as m %}

{# ===========================================================================
   Borrowed: SPATIAL UI. Content stops being a flat page and becomes objects at
   different depths — planes and motes that drift at their own rates on scroll
   and lean toward the pointer. All enhancement: with reduced motion, or on a
   touch screen, the layers rest at their painted depths and nothing is lost.
   =========================================================================== #}
<section id="contact" class="spatial lazy-paint relative overflow-hidden" tabindex="-1" aria-labelledby="contact-title"
         style="background-color:var(--pink); background-image:repeating-linear-gradient(45deg, rgba(0,0,0,.10) 0 16px, transparent 16px 32px)">
  <span class="ghost-word" style="right:-3%; bottom:-4%; -webkit-text-stroke-color:rgba(255,255,255,.22)" aria-hidden="true">HIRE</span>

  <div class="depth-field" aria-hidden="true">
    {%- for layer in depth_layers %}
    <span class="depth-layer depth-{{ layer.kind }}" data-depth="{{ layer.depth }}" style="{{ layer.style }}"></span>
    {%- endfor %}
  </div>

  <div class="relative mx-auto max-w-site px-4 sm:px-6 py-14 sm:py-20" style="z-index:1">
    <div class="sec-head rv">
      <h2 id="contact-title" class="sec-title" style="color:#fff">Contact</h2>
      {{ m.sticker('available now', 'lime', 'anim-pop') }}
      {{ m.credit('spatial UI, 2024') }}
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-[.65fr_1.35fr] items-start">

      <div class="rv rv-slide mx-auto w-full max-w-[260px] lg:max-w-none">
        {{ m.photo(photo, '(min-width:1024px) 22vw, 260px',
                   classes='anim-float', style='transform:rotate(-3deg)', frame_bg='var(--yellow)') }}
      </div>

      <div class="space-y-5">
        <div class="plate card rv">
          <p class="display" style="font-size:clamp(1.6rem,4.5vw,2.5rem); color:var(--yellow)">{{ contact.headline }}</p>
          <p class="mt-4 text-[16px] leading-relaxed">{{ contact.body }}</p>
          <div class="mt-6 flex flex-wrap gap-4">
            {{ m.btn(site.email, 'mailto:' ~ site.email, 'lime') }}
            <button type="button" class="btn btn--cyan" id="copy-email" data-email="{{ site.email }}">Copy address</button>
          </div>
          <p id="copy-status" class="mt-3 text-sm font-bold" style="color:var(--lime)" role="status" aria-live="polite"></p>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          {%- for card in contact.cards %}
          <a class="{{ m.plate(card.accent) }} card rv kinetic" style="text-decoration:none; color:#000"
             href="{{ card.href }}"{% if card.href.startswith('http') %} rel="noopener"{% endif %}>
            <p class="display" style="font-size:1.5rem">{{ card.title }} {{ card.icon }}</p>
            <p class="mt-1.5 text-sm font-bold">{{ card.note }}</p>
          </a>
          {%- endfor %}
        </div>
      </div>

    </div>
  </div>
</section>
