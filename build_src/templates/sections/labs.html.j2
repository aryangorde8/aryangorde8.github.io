{% import "macros.html.j2" as m %}

<section id="labs" class="lazy-paint relative overflow-hidden" tabindex="-1" aria-labelledby="labs-title">
  <span class="ghost-word" style="left:-4%; top:10%;" aria-hidden="true">LABS</span>

  <div class="relative mx-auto max-w-site px-4 sm:px-6 py-14 sm:py-20">
    {{ m.sec_head('labs', 'Labs', m.sticker('weekend damage', 'violet', 'anim-wobble')) }}

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {%- for lab in labs %}
      {%- set dark = lab.accent in m.DARK %}
      {%- set head = m.HEAD_INK.get(lab.accent) %}
      {%- set muted = m.MUTED_INK.get(lab.accent) %}
      <article class="{{ m.plate(lab.accent) }} card rv kinetic">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <h3 class="display" style="font-size:2rem{% if head %}; color:{{ head }}{% endif %}">{{ lab.name }}</h3>
          {{ m.sticker(lab.tag, lab.tag_accent) }}
        </div>
        <p class="mt-3 text-[15px] leading-relaxed">{{ lab.blurb }}</p>
        <p class="mt-3 text-xs font-bold tracking-widest uppercase"{% if muted %} style="color:{{ muted }}"{% endif %}>{{ lab.tech }}</p>
      </article>
      {%- endfor %}
    </div>

    <div class="mt-8 rv">{{ m.btn('All of it on GitHub ↗', site.github, 'pink') }}</div>
  </div>
</section>

<hr class="rule" />
