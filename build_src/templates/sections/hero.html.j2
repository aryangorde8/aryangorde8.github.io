{% import "macros.html.j2" as m %}

<section id="top" class="relative overflow-hidden" aria-labelledby="hero-title">
  <span class="ghost-word anim-spin" style="right:-4%; top:8%;" aria-hidden="true">★</span>

  <div class="relative mx-auto max-w-site px-4 sm:px-6 py-10 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[1.25fr_.75fr] lg:gap-10 items-start">

      <div class="relative z-10">
        <div class="flex flex-wrap gap-2.5">
          {%- for s in hero.stickers %}
          {{ m.sticker(s.text, s.accent, 'anim-wobble' + (' d%d'|format(loop.index0) if loop.index0 else '')) }}
          {%- endfor %}
        </div>

        <h1 id="hero-title" class="display mt-5" style="font-size:clamp(3.25rem,14vw,9rem)">
          {{ hero.first_name }}<br /><span class="outline-text">{{ hero.last_name }}</span>
        </h1>

        <div class="plate card mt-6 max-w-2xl">
          <p class="eyebrow" style="color:var(--cyan)">{{ site.role }}</p>
          <p class="mt-3 text-[16px] sm:text-[18px] leading-relaxed">{{ hero.blurb }}</p>
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-4">
          {{ m.btn('See the work', '#debtclear', 'pink') }}
          {# Borrowed: skeuomorphism — a real bevel, lit from above, that
             physically sinks 6px when pressed. #}
          <a class="btn skeuo" href="{{ site.resume }}">Résumé ⤓</a>
          {{ m.btn('Hire me', '#contact', 'black') }}
          {{ m.credit('↑ skeuomorphism, 2007') }}
        </div>
      </div>

      <div class="relative z-10 mx-auto w-full max-w-[340px] lg:max-w-none">
        {% call m.photo(photo, '(min-width:1024px) 26vw, (min-width:640px) 340px, 88vw',
                        classes='anim-float', style='transform:rotate(2deg)', eager=true) %}
          {# Borrowed: liquid glass — refractive rim, inner glow pooling at the
             bottom edge, and a specular sweep that travels across it. #}
          <div class="liquid" data-frost
               style="position:absolute; left:12px; right:12px; bottom:12px; padding:.75rem .9rem; z-index:25">
            <p class="text-[13px] font-bold leading-tight">{{ hero.photo_badge }}</p>
          </div>
        {% endcall %}
        {{ m.sticker('Hello 👋', 'violet', 'anim-wobble d3')|replace('<span class="sticker',
           '<span style="position:absolute; bottom:-14px; left:-10px; z-index:20" class="sticker') }}
        <p class="mt-4 text-center lg:text-left">{{ m.credit('↑ liquid glass, 2025', light=true) }}</p>
      </div>

    </div>
  </div>
</section>

{{ m.marquee(marquees.stack, 'marquee--pink') }}
