{% import "macros.html.j2" as m %}

{# ===========================================================================
   Borrowed: MINIMALISM. A full-bleed strip of restraint dropped into the
   loudest page on the internet. One accent, hairline rules, a narrow measure,
   and a great deal of air. The surrounding noise is what makes this read as
   confidence rather than as an empty section.
   =========================================================================== #}
<section id="debtclear" class="minimal lazy-paint" tabindex="-1" aria-labelledby="debtclear-title"
         style="border-top:6px solid #000; border-bottom:6px solid #000">
  <div class="mx-auto max-w-3xl px-5 sm:px-8 py-20 sm:py-32">

    <div class="flex items-center justify-between gap-4 rv">
      <p class="text-[11px] tracking-[0.24em] uppercase font-semibold minimal-accent">Featured build</p>
      {{ m.credit('minimalism, perennial', light=true) }}
    </div>

    <h2 id="debtclear-title" class="mt-10 rv"
        style="font-size:clamp(2.75rem,9vw,5rem); font-weight:300; letter-spacing:-.03em; line-height:1.02">
      {{ featured.name_head }}{{ featured.name_tail }}
    </h2>

    <p class="mt-8 rv" style="font-size:clamp(1.125rem,2.6vw,1.375rem); line-height:1.6; color:#2a2a28; max-width:38rem">
      {{ featured.summary }}
    </p>

    <div class="mt-20 grid gap-y-12 sm:grid-cols-2 sm:gap-x-14 rv">
      {%- for fig in featured.figures %}
      <div>
        <p class="minimal-accent" style="font-size:clamp(2rem,6vw,3.25rem); font-weight:300; letter-spacing:-.03em; line-height:1">{{ fig.value }}</p>
        <p class="mt-3 text-sm leading-relaxed" style="color:#57574f">{{ fig.note }}</p>
      </div>
      {%- endfor %}
    </div>

    <hr class="hair mt-20" />

    <dl class="mt-14 space-y-9 text-[15px] rv">
      {%- for label, body in featured.detail %}
      <div class="sm:grid sm:grid-cols-[9rem_1fr] sm:gap-8">
        <dt class="text-[11px] tracking-[0.18em] uppercase font-semibold" style="color:#57574f">{{ label }}</dt>
        <dd class="mt-2 sm:mt-0 leading-relaxed" style="color:#2a2a28">{{ body }}</dd>
      </div>
      {%- endfor %}
    </dl>

    <hr class="hair mt-14" />

    <div class="mt-12 flex flex-wrap gap-8 text-[15px] rv">
      {%- for link in featured.links %}
      <a class="font-medium" style="color:#121212; text-decoration:none; border-bottom:1px solid #a3005f; padding-bottom:2px"
         href="{{ link.href }}" rel="noopener">{{ link.label }} <span aria-hidden="true">&#8599;</span></a>
      {%- endfor %}
    </div>
  </div>
</section>
